<Window x:Class="Rekenmachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rekenmachine"
        mc:Ignorable="d"
        Title="Rekenmachine" Height="450" Width="800">
    <Grid>
        <Menu VerticalAlignment="Top">
            <MenuItem Header="Bestand"></MenuItem>
            <MenuItem Header="Aard oefening">
                <MenuItem Header="Optellen" IsCheckable="True" Click="addButton_Click"></MenuItem>
                <MenuItem Header="Aftrekken" IsCheckable="True" Click="minusButton_Click"></MenuItem>
                <MenuItem Header="Vermenigvuldiging" IsCheckable="True" Click="multiplyButton_Click"></MenuItem>
                <MenuItem Header="Deling" IsCheckable="True" Click="divideButton_Click"></MenuItem>
            </MenuItem>
        </Menu>
        <Label Content="Getal 1" HorizontalAlignment="Left" Margin="117,121,0,0" VerticalAlignment="Top"/>
        <Label Content="Getal 2" HorizontalAlignment="Left" Margin="117,217,0,0" VerticalAlignment="Top"/>
        <Label Content="Resultaat" HorizontalAlignment="Left" Margin="117,327,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="number1TextBox" HorizontalAlignment="Left" Margin="225,129,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="number2TextBox" HorizontalAlignment="Left" Margin="225,221,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="resultTextBox" HorizontalAlignment="Left" Margin="225,335,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="addButton" Content="+" HorizontalAlignment="Left" Margin="459,108,0,0" VerticalAlignment="Top" Height="60" Width="60" FontSize="22" Click="addButton_Click"/>
        <Button x:Name="multiplyButton" Content="*" HorizontalAlignment="Left" Margin="558,107,0,0" VerticalAlignment="Top" Height="60" Width="60" FontSize="22" Click="multiplyButton_Click"/>
        <Button x:Name="minusButton" Content="-" HorizontalAlignment="Left" Margin="459,196,0,0" VerticalAlignment="Top" Height="59" Width="60" Click="minusButton_Click"/>
        <Button x:Name="divideButton" Content=":" HorizontalAlignment="Left" Margin="558,195,0,0" VerticalAlignment="Top" Height="60" Width="60" Click="divideButton_Click"/>
        <Button x:Name="clearButton" Content="Wissen" HorizontalAlignment="Left" Margin="489,338,0,0" VerticalAlignment="Top" Width="99" Click="clearButton_Click"/>

    </Grid>
</Window>
